{
  "name": "@local/dsh-client-ui-sidebar-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive terminal as a dsh Web right-Sidebar tab: a local PTY streamed to xterm.js over authenticated /api routes.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
