{
  "name": "@local/dsh-client-ui-subagent-subsession",
  "version": "0.1.0",
  "private": true,
  "description": "Expandable subagent subsession in the conversation: a tool-row view plus the authenticated transcript route that feeds it.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
